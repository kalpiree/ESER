# Copy this file to configs/ihpc.env and adjust values for your account.

IHPC_HOST="ihpc-access"
IHPC_REMOTE_DIR="/data/USER/eser"

# Optional compute node, for example dsmi1, mimas1, or saturn13.
# Leave empty to run on the access host.
IHPC_EXEC_HOST=""

# Optional setup command evaluated before each remote command.
IHPC_REMOTE_PRELUDE=""

# Local directory for receipts and pulled logs.
IHPC_LOCAL_LOG_DIR="logs/ihpc"
