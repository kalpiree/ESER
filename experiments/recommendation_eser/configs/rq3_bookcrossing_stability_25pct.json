{
  "name": "rq3_bookcrossing_stability_25pct",
  "normalize_scores": true,
  "data": {
    "users_path": "../data/prepared/bookcrossing/users.csv",
    "items_path": "../data/prepared/bookcrossing/items.csv",
    "interactions_path": "../data/prepared/bookcrossing/interactions.csv",
    "group_column": "age_binary_group",
    "secondary_group_column": "activity_group",
    "timestamp_column": "timestamp",
    "min_history": 5,
    "max_eval_users": 5000
  },
  "split": {
    "calibration_positive_count": 1,
    "test_positive_count": 1,
    "negative_sample_size": 50,
    "seed": 17
  },
  "scorer": {
    "kind": "token_overlap"
  },
  "methods": [
    {
      "name": "group_thr",
      "kind": "group_threshold",
      "alpha": 0.15,
      "beta": 0.15,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64
    },
    {
      "name": "eser_s",
      "kind": "eser",
      "alpha": 0.15,
      "beta": 0.15,
      "eta": 0.08,
      "delta_hat": 0.05,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64,
      "stability_mode": "none"
    },
    {
      "name": "eser",
      "kind": "eser",
      "alpha": 0.15,
      "beta": 0.15,
      "eta": 0.08,
      "delta_hat": 0.05,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64,
      "stability_mode": "user_leave_one_out"
    }
  ]
}
