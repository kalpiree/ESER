{
  "name": "rq_ltt_lastfm1k_threshold_diagnostics",
  "normalize_scores": true,
  "data": {
    "users_path": "../data/prepared/lastfm1k/users.csv",
    "items_path": "../data/prepared/lastfm1k/items.csv",
    "interactions_path": "../data/prepared/lastfm1k/interactions.csv",
    "group_column": "region_binary_group",
    "secondary_group_column": "activity_group",
    "timestamp_column": "timestamp",
    "min_history": 5,
    "case_seed_name": "lastfm1k_token_overlap"
  },
  "split": {
    "calibration_positive_count": 1,
    "test_positive_count": 1,
    "negative_sample_size": 50,
    "seed": 17
  },
  "scorer": {
    "kind": "token_overlap"
  },
  "methods": [
    {
      "name": "ltt_group_balanced",
      "kind": "group_threshold",
      "alpha": 0.15,
      "beta": 0.15,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64
    },
    {
      "name": "ltt_global_balanced",
      "kind": "global_threshold",
      "alpha": 0.15,
      "beta": 0.15,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_global": 128
    },
    {
      "name": "ltt_group_lenient",
      "kind": "group_threshold",
      "alpha": 0.2,
      "beta": 0.2,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64
    },
    {
      "name": "ltt_global_lenient",
      "kind": "global_threshold",
      "alpha": 0.2,
      "beta": 0.2,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_global": 128
    },
    {
      "name": "topk10_reference",
      "kind": "top_k",
      "k": 10,
      "omega": 1.0,
      "utility_metric": "ndcg"
    }
  ]
}
