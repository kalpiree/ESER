{
  "name": "rq_mainfair_amazon_books_qwen25_3b_50neg",
  "normalize_scores": true,
  "data": {
    "users_path": "../data/prepared/amazon_books/users.csv",
    "items_path": "../data/prepared/amazon_books/items.csv",
    "interactions_path": "../data/prepared/amazon_books/interactions.csv",
    "group_column": "cold_start_group",
    "secondary_group_column": "activity_group",
    "timestamp_column": "timestamp",
