      "utility_metric": "ndcg",
      "top_k_grid": [
        3,
        5,
        10,
        15,
        20,
        30
      ],
      "item_penalty_grid": [
        0.0,
        0.25,
        0.5,
        1.0,
        2.0
      ],
      "utility_penalty": 0.5
    },
    {
      "name": "ltt",
      "kind": "ltt",
