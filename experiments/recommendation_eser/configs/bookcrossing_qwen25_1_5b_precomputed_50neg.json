{
  "name": "bookcrossing_qwen25_1_5b_precomputed_50neg",
  "normalize_scores": true,
  "data": {
    "users_path": "../data/prepared/bookcrossing/users.csv",
    "items_path": "../data/prepared/bookcrossing/items.csv",
    "interactions_path": "../data/prepared/bookcrossing/interactions.csv",
    "group_column": "age_binary_group",
    "secondary_group_column": "activity_group",
    "timestamp_column": "timestamp",
    "min_history": 5,
    "max_eval_users": 2450
  },
  "split": {
    "calibration_positive_count": 1,
    "test_positive_count": 1,
    "negative_sample_size": 50,
    "seed": 17
  },
  "scorer": {
    "kind": "precomputed_jsonl",
    "scores_path": "../outputs/scores/bookcrossing/qwen25_1_5b_scores_50neg_multillm.jsonl"
  },
  "methods": [
    {
      "name": "eser",
      "kind": "eser",
      "alpha": 0.15,
      "beta": 0.15,
      "eta": 0.08,
      "delta_hat": 0.05,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64,
      "stability_mode": "none"
    },
    {
      "name": "eser_s",
      "kind": "eser",
      "alpha": 0.15,
      "beta": 0.15,
      "eta": 0.08,
      "delta_hat": 0.05,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64,
      "stability_mode": "none"
    },
    {
      "name": "group_thr",
      "kind": "group_threshold",
      "alpha": 0.15,
      "beta": 0.15,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64
    },
    {
      "name": "global_thr",
      "kind": "global_threshold",
      "alpha": 0.15,
      "beta": 0.15,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_global": 128
    },
    {
      "name": "coverage_set",
      "kind": "coverage_set",
      "beta": 0.15,
      "omega": 1.0,
      "utility_metric": "ndcg",
      "max_thresholds_per_group": 64
    },
    {
      "name": "topk",
      "kind": "top_k",
      "k": 10,
      "omega": 1.0,
      "utility_metric": "ndcg"
    },
    {
      "name": "topk_matched_eser",
      "kind": "top_k_matched",
      "match_to": "eser",
      "omega": 1.0,
      "utility_metric": "ndcg"
    }
  ]
}
